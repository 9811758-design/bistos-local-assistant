{
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 700},
          "source_ids": {
            "type": "array",
            "minItems": 1,
          "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^C[1-8]$"}
          }
        }
      }
    }
  }
}
