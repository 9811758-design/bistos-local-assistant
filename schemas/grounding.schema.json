{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["supported", "issues"],
  "properties": {
    "supported": {"type": "boolean"},
    "issues": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["unsupported_claim", "wrong_scope", "missing_condition", "irrelevant_answer", "contradiction"]
      }
    }
  }
}
